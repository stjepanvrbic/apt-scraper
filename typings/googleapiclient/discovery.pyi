class HttpRequest:
    def execute(self) -> dict[str, object]: ...

class EventsResource:
    def patch(self, *, calendarId: str, eventId: str, body: dict[str, object]) -> HttpRequest: ...
    def insert(self, *, calendarId: str, body: dict[str, object]) -> HttpRequest: ...
    def delete(self, *, calendarId: str, eventId: str) -> HttpRequest: ...

class Resource:
    def events(self) -> EventsResource: ...
